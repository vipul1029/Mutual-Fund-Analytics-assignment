{
  "name": "mutual-fund-analytics-backend",
  "version": "1.0.0",
  "description": "Production-grade mutual fund analytics backend using Fastify, Prisma, BullMQ, Redis, and Bottleneck.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "sync:trigger": "node -e \"import('./src/pipeline/syncService.js').then(({ triggerManualSync }) => triggerManualSync().then(() => process.exit(0)).catch((err) => { console.error(err); process.exit(1); }));\"",
    "test": "vitest run",
    "benchmark:api": "node scripts/benchmark-api.js",
    "proof:rate-limit": "node scripts/rate-limit-proof.js"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/sensible": "^5.6.0",
    "@prisma/client": "^5.20.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.17.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "vitest": "^2.1.1"
  }
}
